# ─── Sentinel Hub (OAuth2) ───────────────────────────────────────────────────
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=

# ─── Oxlo.ai ─────────────────────────────────────────────────────────────────
OXLO_API_KEY=
OXLO_BASE_URL=https://api.oxlo.ai/v1
OXLO_VISION_MODEL=yolov9
OXLO_REASONING_MODEL=deepseek-r1

# ─── Supabase (Database & RAG) ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                      # High-privilege key for server use ONLY

# ─── App Settings ─────────────────────────────────────────────────────────────
# ─── Frontend & Deployment ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000               # Backend API URL (Use VPS public IP/Domain in production)
APP_PUBLIC_URL=http://localhost:5173            # Used for Certificate QR Code links (UI URL)

# ─── Miscellaneous ───────────────────────────────────────────────────────────
APP_ENV=development                             # development | production
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
CONFIDENCE_THRESHOLD=0.7
DEFORESTATION_CUTOFF_DATE=2020-12-31
MAX_CLOUD_COVER_PCT=10
